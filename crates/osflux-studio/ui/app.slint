// OSflux Studio's window: header, rail, the current step's screen with its
// action bar, the status bar, and the Settings and About dialogs.

import { Theme, ThemeChoice, Status } from "theme.slint";
import {
    Studio, Screen, StepState, StepData, SummaryData, HintIcon, DriveKind, PlanRowData, NoteData,
    DriveData, BlockedDriveData, CheckData, DetailData, DetailRowData, ConfirmDriveData, MatchState
} from "state.slint";
import { SquareButton, ButtonKind } from "components/button.slint";
import { ScrollArea } from "components/scroll.slint";
import { Header, Rail, ActionBar, StatusBar } from "shell.slint";
import { Body, Label, Mono } from "components/text.slint";
import {
    TitleBlock, ImageEmptyScreen, ImageCheckedScreen, DriveScreen, SafetyScreen,
    WindowsOptionsScreen, ConfirmScreen
} from "screens.slint";
import { SettingsDialog, AboutDialog } from "dialogs.slint";
import { Gallery } from "gallery.slint";

export {
    Theme, ThemeChoice, Status, Studio, Screen, StepState, StepData, SummaryData, HintIcon, DriveKind,
    PlanRowData, NoteData, DriveData, BlockedDriveData, CheckData, DetailData, DetailRowData,
    ConfirmDriveData, MatchState, Gallery
}

export component AppWindow inherits Window {
    title: "OSflux Studio";
    icon: @image-url("../../../assets/brand/icons/windows/osflux-256.png");
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 960px;
    min-height: 640px;
    background: Theme.bg;
    default-font-family: Theme.sans;
    default-font-size: Theme.body-size;

    VerticalLayout {
        Header { }
        HorizontalLayout {
            vertical-stretch: 1;
            Rail { }
            VerticalLayout {
                horizontal-stretch: 1;
                scroll := ScrollArea {
                    vertical-stretch: 1;
                    content-height: page.preferred-height;
                    page := VerticalLayout {
                        width: scroll.width;
                        // Before an image is chosen the drop zone fills the
                        // page, as in frame 01. Other screens keep their
                        // natural height.
                        min-height: Studio.screen == Screen.image && !Studio.image-chosen ? scroll.height : 0px;
                        alignment: Studio.screen == Screen.image && !Studio.image-chosen ? LayoutAlignment.stretch : LayoutAlignment.start;
                        padding-left: Theme.content-padding-x;
                        padding-right: Theme.content-padding-x;
                        padding-top: Theme.content-padding-top;
                        padding-bottom: 24px;
                        spacing: 24px;

                        TitleBlock {
                            status: Studio.screen == Screen.safety && !Studio.safety-busy ? Studio.verdict : Status.none;

                            // Frames 05–06: how much room the image needs.
                            if Studio.screen == Screen.drive && Studio.image-needs != "": VerticalLayout {
                                alignment: end;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Label {
                                        text: "Image needs";
                                        font-size: 13px;
                                    }
                                    Mono {
                                        text: Studio.image-needs;
                                        font-size: 13px;
                                    }
                                }
                            }
                            // Frame 07: the count; frame 08: the way out.
                            if Studio.screen == Screen.safety && Studio.checks-passed != "": VerticalLayout {
                                alignment: end;
                                Mono {
                                    text: Studio.checks-passed;
                                    font-size: 13px;
                                    color: Theme.text-secondary;
                                }
                            }
                            if Studio.screen == Screen.safety && Studio.fix-label != "": VerticalLayout {
                                alignment: center;
                                padding-top: 24px;
                                SquareButton {
                                    width: 216px;
                                    button-height: 48px;
                                    text: Studio.fix-label;
                                    kind: ButtonKind.secondary;
                                    icon: Studio.fix-label == "Choose another drive" ? @image-url("icons/usb.svg") : @image-url("icons/file.svg");
                                    clicked => { Studio.fix(); }
                                }
                            }
                        }
                        if Studio.screen == Screen.image && !Studio.image-chosen: ImageEmptyScreen {
                            vertical-stretch: 1;
                        }
                        if Studio.screen == Screen.image && Studio.image-chosen: ImageCheckedScreen { }
                        if Studio.screen == Screen.drive: DriveScreen { }
                        if Studio.screen == Screen.safety: SafetyScreen { }
                        if Studio.screen == Screen.windows-options: WindowsOptionsScreen { }
                        if Studio.screen == Screen.confirm: ConfirmScreen { }
                    }
                }
                ActionBar {
                    hint: Studio.hint;
                    icon: Studio.hint-icon;
                    SquareButton {
                        width: 127px;
                        text: "Back";
                        kind: ButtonKind.secondary;
                        enabled: Studio.can-go-back;
                        show-icon: false;
                        clicked => { Studio.back(); }
                    }
                    if Studio.offer-another-image: SquareButton {
                        width: 224px;
                        text: "Choose another image";
                        kind: ButtonKind.secondary;
                        icon: @image-url("icons/file.svg");
                        clicked => { Studio.choose-image(); }
                    }
                    if Studio.screen != Screen.confirm: SquareButton {
                        width: 177px;
                        text: "Next";
                        kind: ButtonKind.primary;
                        enabled: Studio.can-go-next;
                        icon: @image-url("icons/arrow-right.svg");
                        clicked => { Studio.next(); }
                    }
                    // Red, and locked until the code or phrase matches.
                    if Studio.screen == Screen.confirm: SquareButton {
                        width: 208px;
                        text: "Write to drive";
                        kind: ButtonKind.danger;
                        enabled: Studio.can-write;
                        icon: Studio.can-write ? @image-url("icons/arrow-right.svg") : @image-url("icons/lock.svg");
                        clicked => { Studio.write(); }
                    }
                }
            }
        }
        StatusBar { }
    }

    if Studio.settings-open: SettingsDialog {
        done => { Studio.settings-open = false; }
    }
    if Studio.about-open: AboutDialog {
        done => {
            Studio.about-open = false;
            Studio.showing-licences = false;
        }
    }
}
