// Bands and the tag from the component sheet. A band is a tinted block with
// a status icon, a bold title, a body line and, optionally, an action on
// the right: info (blue), amber and red.

import { Theme, Status } from "../theme.slint";
import { Body } from "text.slint";
import { StatusIcon } from "status.slint";

export enum BandKind { info, amber, red }

export component Band inherits Rectangle {
    in property <BandKind> kind: BandKind.info;
    in property <string> title;
    in property <string> body;
    // An inline note, as under an option or a setting: tighter padding.
    in property <bool> compact;

    background: kind == BandKind.info ? Theme.info-band
        : kind == BandKind.amber ? Theme.amber-band : Theme.warning-band;
    min-height: layout.min-height;
    accessible-role: AccessibleRole.text;
    accessible-label: title == "" ? body : title + ". " + body;

    layout := HorizontalLayout {
        padding-left: root.compact ? 16px : 18px;
        padding-right: 16px;
        padding-top: root.compact ? 7px : 16px;
        padding-bottom: root.compact ? 7px : 16px;
        spacing: root.compact ? 12px : 14px;
        VerticalLayout {
            alignment: root.title == "" ? center : start;
            padding-top: root.title == "" ? 0 : 2px;
            if root.kind == BandKind.info: Image {
                width: root.compact ? 16px : 18px;
                height: root.compact ? 16px : 18px;
                source: @image-url("../icons/info.svg");
                colorize: Theme.link;
            }
            if root.kind != BandKind.info: StatusIcon {
                status: root.kind == BandKind.amber ? Status.needs-inspection : Status.blocked;
                size: root.compact ? 16px : 18px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            if root.title != "": Body {
                text: root.title;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.body != "": Body {
                text: root.body;
                color: root.title == "" ? Theme.text : Theme.text-secondary;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// "⚠ Will be erased": red text on a red tint.
export component Tag inherits Rectangle {
    in property <string> text;

    background: Theme.tag-bg;
    width: row.preferred-width;
    height: 28px;
    accessible-role: AccessibleRole.text;
    accessible-label: text;

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 14px;
                height: 14px;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: "M 8 1.2 L 15.2 14.4 L 0.8 14.4 Z M 8 6 L 8 9.6 M 8 11.4 L 8 12.4";
                stroke: Theme.tag-text;
                stroke-width: 1.3px;
            }
        }
        Body {
            text: root.text;
            font-weight: 600;
            font-size: 13px;
            color: Theme.tag-text;
        }
    }
}
