// Buttons from the component sheet: square, label left, icon right; 64 px
// in the action bar and 48 px inline. Write to drive is the red danger kind
// and unlocks only when the drive is confirmed.

import { Theme } from "../theme.slint";
import { Body } from "text.slint";
import { KeyFocus } from "focus.slint";

export enum ButtonKind { primary, secondary, danger }

export component SquareButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> show-icon: true;
    in property <ButtonKind> kind: ButtonKind.primary;
    in property <bool> enabled: true;
    // 64 in the action bar, 48 for inline actions.
    in property <length> button-height: Theme.action-bar-height;
    callback clicked;

    property <bool> hovered: touch.has-hover && enabled;
    property <bool> down: touch.pressed && enabled;
    property <color> foreground: !enabled ? Theme.text-disabled
        : kind == ButtonKind.primary ? Theme.on-accent
        : kind == ButtonKind.danger ? Theme.on-danger
        : Theme.on-secondary;

    min-width: row.min-width;
    height: button-height;
    background: !enabled ? Theme.layer-02
        : kind == ButtonKind.primary ? (down ? #004A9C : hovered ? #0058BA : Theme.accent)
        : kind == ButtonKind.danger ? (down ? #991B1B : hovered ? #B91C1C : Theme.danger)
        : (down ? #6F6F6F : hovered ? #4C4C4C : Theme.secondary-button);

    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (enabled) {
            clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    focus := KeyFocus {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 24px;
        Body {
            text: root.text;
            color: root.foreground;
            horizontal-alignment: left;
            horizontal-stretch: 1;
        }
        if root.show-icon: VerticalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: root.icon;
                colorize: root.foreground;
            }
        }
    }

    // Keyboard focus only: a 2 px inset ring in the link colour.
    if focus.has-focus && focus.keyboard: Rectangle {
        border-width: 2px;
        border-color: root.kind == ButtonKind.secondary || !root.enabled ? Theme.link : #FFFFFF;
    }
}

// Text in the link colour, underlined on hover; disabled, it sits in a
// layer-02 box with disabled text.
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <length> font-size: Theme.body-size;
    in property <image> icon;
    in property <bool> show-icon: false;
    // Links put the icon after the text ("Website ↗"); Refresh puts it first.
    in property <bool> icon-after;
    in property <bool> enabled: true;
    callback clicked;

    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (enabled) {
            clicked();
        }
    }

    min-width: row.min-width;
    min-height: row.min-height;
    background: enabled ? transparent : Theme.layer-02;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    focus := KeyFocus {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    row := HorizontalLayout {
        spacing: 8px;
        alignment: start;
        padding-left: root.enabled ? 0 : 16px;
        padding-right: root.enabled ? 0 : 16px;
        padding-top: root.enabled ? 0 : 8px;
        padding-bottom: root.enabled ? 0 : 8px;
        if root.show-icon && !root.icon-after: VerticalLayout {
            alignment: center;
            Image {
                width: root.font-size + 2px;
                height: root.font-size + 2px;
                source: root.icon;
                colorize: root.enabled ? Theme.link : Theme.text-disabled;
            }
        }
        label := Body {
            text: root.text;
            font-size: root.font-size;
            color: root.enabled ? Theme.link : Theme.text-disabled;
        }
        if root.show-icon && root.icon-after: HorizontalLayout {
            padding-left: 18px;
            VerticalLayout {
                alignment: center;
                Image {
                    width: root.font-size + 4px;
                    height: root.font-size + 4px;
                    source: root.icon;
                    colorize: root.enabled ? Theme.link : Theme.text-disabled;
                }
            }
        }
    }
    if root.enabled && (touch.has-hover || (focus.has-focus && focus.keyboard)): Rectangle {
        x: label.x;
        y: label.y + label.height - 2px;
        width: label.width;
        height: 1px;
        background: Theme.link;
    }
}

// The 48 × 48 Settings and About buttons in the header.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked;

    width: 48px;
    height: 48px;
    background: touch.pressed ? Theme.selected : touch.has-hover ? Theme.layer-01 : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := KeyFocus {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    Image {
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: touch.has-hover ? Theme.text : Theme.text-secondary;
    }
    if focus.has-focus && focus.keyboard: Rectangle {
        border-width: 2px;
        border-color: Theme.link;
    }
}
