// One write phase (Writing or Verifying): its state, the engine's phase
// name, a progress bar in the accent colour, and speed, amount done and
// time left.

import { Theme } from "../theme.slint";
import { Body, Label, Mono } from "text.slint";

export enum PhaseState { waiting, active, done }

export component PhaseProgress inherits Rectangle {
    in property <string> title;
    // The engine's name for the phase: writing, verifying.
    in property <string> engine-phase;
    in property <string> description;
    in property <PhaseState> state;
    // 0 to 1.
    in property <float> progress;
    in property <string> speed;
    in property <string> done;
    in property <string> time-label: "Time left";
    in property <string> time;

    property <color> value-color: state == PhaseState.waiting ? Theme.text-secondary : Theme.text;

    background: Theme.layer-01;
    min-height: layout.min-height;
    accessible-role: progress-indicator;
    accessible-label: title;
    accessible-value: round(progress * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;

    layout := VerticalLayout {
        padding: 20px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    border-width: 1.5px;
                    border-color: root.state == PhaseState.waiting ? Theme.text-secondary : Theme.link;
                    if root.state == PhaseState.active: Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: Theme.link;
                    }
                    if root.state == PhaseState.done: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 4.6 8.2 L 7 10.5 L 11.4 5.9";
                        stroke: Theme.link;
                        stroke-width: 1.5px;
                    }
                }
            }
            Body {
                text: root.title;
                font-size: 16px;
                font-weight: 600;
                color: root.state == PhaseState.waiting ? Theme.text-secondary : Theme.text;
            }
            Mono {
                text: root.engine-phase;
                font-size: 12px;
                color: Theme.text-secondary;
            }
            Body {
                text: root.description;
                color: Theme.text-secondary;
                horizontal-stretch: 1;
            }
            Mono {
                text: round(root.progress * 100) + "%";
                font-size: 20px;
                color: root.value-color;
            }
        }
        Rectangle {
            height: 7px;
            background: Theme.progress-track;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.progress, 0, 1);
                background: Theme.accent;
            }
        }
        HorizontalLayout {
            spacing: 24px;
            for column[index] in [
                { label: "Speed", value: root.speed },
                { label: "Done", value: root.done },
                { label: root.time-label, value: root.time },
            ]: VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Label {
                    text: column.label;
                    font-size: 13px;
                }
                Mono {
                    text: column.value;
                    font-size: 16px;
                    color: root.value-color;
                }
            }
        }
    }
}
