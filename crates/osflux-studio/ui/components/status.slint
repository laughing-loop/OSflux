// Engine status as shape + colour + label: Ready = circle with a check,
// Needs confirmation = circle with i, Needs inspection = triangle with !,
// Blocked = octagon with ×. Never colour alone.

import { Theme, Status } from "../theme.slint";
import { Body } from "text.slint";

export component StatusIcon inherits Rectangle {
    in property <Status> status;
    in property <length> size: 16px;
    // The information icon for notes without a status.
    in property <bool> info-when-none: true;

    width: size;
    height: size;
    accessible-role: image;
    accessible-label: status == Status.ready ? "Ready"
        : status == Status.needs-confirmation ? "Needs confirmation"
        : status == Status.needs-inspection ? "Needs inspection"
        : status == Status.blocked ? "Blocked"
        : status == Status.not-checked ? "Not checked" : "Information";

    property <length> stroke: size * 1.9 / 16;
    property <color> shape: Theme.status-color(status);

    if status == Status.ready || status == Status.needs-confirmation: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 0 A 8 8 0 0 1 8 16 A 8 8 0 0 1 8 0 Z";
        fill: root.shape;
    }
    if status == Status.needs-inspection: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 0.6 L 15.8 15 L 0.2 15 Z";
        fill: root.shape;
    }
    if status == Status.blocked: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 4.7 0 L 11.3 0 L 16 4.7 L 16 11.3 L 11.3 16 L 4.7 16 L 0 11.3 L 0 4.7 Z";
        fill: root.shape;
    }
    if status == Status.ready: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 4.4 8.3 L 6.9 10.7 L 11.6 5.7";
        stroke: Theme.status-glyph;
        stroke-width: root.stroke;
    }
    if status == Status.needs-confirmation: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 6.9 L 8 12.2 M 8 3.9 L 8 4.9";
        stroke: Theme.status-glyph;
        stroke-width: root.stroke;
    }
    if status == Status.needs-inspection: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 5.6 L 8 10 M 8 11.7 L 8 12.8";
        stroke: Theme.status-glyph;
        stroke-width: root.stroke;
    }
    if status == Status.blocked: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5.3 5.3 L 10.7 10.7 M 10.7 5.3 L 5.3 10.7";
        stroke: Theme.status-glyph;
        stroke-width: root.stroke;
    }
    // A check the engine did not reach: an outlined circle with a dash.
    if status == Status.not-checked: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 0.75 A 7.25 7.25 0 0 1 8 15.25 A 7.25 7.25 0 0 1 8 0.75 Z M 4.75 8 L 11.25 8";
        stroke: Theme.text-secondary;
        stroke-width: root.size * 1.25 / 16;
    }
    // Notes without a status: an outlined information icon.
    if status == Status.none && info-when-none: Image {
        width: 100%;
        height: 100%;
        source: @image-url("../icons/info.svg");
        colorize: Theme.text-secondary;
    }
}

// Icon and label together, as in "✓ Ready".
export component StatusLabel inherits HorizontalLayout {
    in property <Status> status;
    in property <string> text;
    in property <length> icon-size: 16px;
    in property <length> font-size: Theme.body-size;

    spacing: 10px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        StatusIcon {
            status: root.status;
            size: root.icon-size;
        }
    }
    Body {
        text: root.text;
        font-size: root.font-size;
    }
}
