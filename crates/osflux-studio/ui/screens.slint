// The step screens. Each reads the Studio global.

import { Theme, Status } from "theme.slint";
import { Studio, Screen } from "state.slint";
import { Body, Label, Mono, Section, Title } from "components/text.slint";
import { StatusIcon, StatusLabel } from "components/status.slint";
import { SquareButton, ButtonKind, GhostButton } from "components/button.slint";
import { Band, BandKind, Tag } from "components/band.slint";
import { TextField, OptionRow, CodeBoxes, PhraseField, MatchMessage } from "components/inputs.slint";
import { Tooltip } from "components/tooltip.slint";
import {
    SectionHeader, KeyValueRow, NoteRow, DriveTableHeader, DriveRow, BlockedDriveRow,
    ChecklistRow, DetailGrid, DriveIcon
} from "components/rows.slint";

// "Step 1 of 4", the title (with a status icon for verdicts and results),
// the description, and anything passed as children on the right.
export component TitleBlock inherits VerticalLayout {
    in property <Status> status: Status.none;

    spacing: 4px;
    Label {
        text: Studio.step-label;
        font-size: 13px;
        letter-spacing: Theme.body-spacing;
    }
    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            HorizontalLayout {
                spacing: 14px;
                alignment: start;
                if root.status != Status.none: VerticalLayout {
                    alignment: center;
                    StatusIcon {
                        status: root.status;
                        size: 28px;
                    }
                }
                Title {
                    text: Studio.title;
                    height: 34px;
                }
            }
            Body {
                text: Studio.description;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// Step 1 before an image is chosen: the drop zone with Browse.
export component ImageEmptyScreen inherits VerticalLayout {
    spacing: 24px;

    Rectangle {
        min-height: 360px;
        vertical-stretch: 1;
        background: Theme.layer-01;
        border-width: 1px;
        border-color: Theme.border-strong;
        accessible-role: groupbox;
        accessible-label: "Drop an image file here, or browse for one";

        VerticalLayout {
            alignment: center;
            spacing: 0;
            HorizontalLayout {
                alignment: center;
                Image {
                    width: 28px;
                    height: 28px;
                    source: @image-url("icons/upload.svg");
                    colorize: Theme.text-secondary;
                }
            }
            Rectangle {
                height: 19px;
            }
            Body {
                text: "Drop an image file here";
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 8px;
            }
            HorizontalLayout {
                alignment: center;
                Body {
                    text: "Windows 11 and Linux ISO images (";
                    color: Theme.text-secondary;
                }
                Mono {
                    text: ".iso";
                    font-size: 14px;
                }
                Body {
                    text: ") and raw disk images (";
                    color: Theme.text-secondary;
                }
                Mono {
                    text: ".img";
                    font-size: 14px;
                }
                Body {
                    text: ", ";
                    color: Theme.text-secondary;
                }
                Mono {
                    text: ".raw";
                    font-size: 14px;
                }
                Body {
                    text: ")";
                    color: Theme.text-secondary;
                }
            }
            Rectangle {
                height: 14px;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 56px;
                        height: 1px;
                        background: Theme.border-strong;
                    }
                }
                Label {
                    text: "or";
                    font-size: 13px;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 56px;
                        height: 1px;
                        background: Theme.border-strong;
                    }
                }
            }
            Rectangle {
                height: 16px;
            }
            HorizontalLayout {
                alignment: center;
                SquareButton {
                    width: 176px;
                    button-height: 48px;
                    text: Studio.image-busy ? "Reading…" : "Browse…";
                    kind: ButtonKind.secondary;
                    enabled: !Studio.image-busy;
                    icon: @image-url("icons/file.svg");
                    clicked => { Studio.choose-image(); }
                }
            }
        }
    }

    if Studio.image-error != "": Band {
        kind: BandKind.red;
        compact: true;
        body: Studio.image-error;
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: @image-url("icons/info.svg");
                colorize: Theme.text-secondary;
            }
        }
        Body {
            text: "At this step OSflux only reads the file. Nothing is changed or written.";
            color: Theme.text-secondary;
            font-size: 13px;
        }
    }
}

// The chosen file: name, full path, size and Change image, with the
// optional expected SHA-256 underneath.
component ImageCard inherits Rectangle {
    background: Theme.layer-01;

    VerticalLayout {
        HorizontalLayout {
            height: 64px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 18px;
                    height: 18px;
                    source: @image-url("icons/disc.svg");
                    colorize: Theme.text-secondary;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 1px;
                Body {
                    text: Studio.image-name;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                path-text := Mono {
                    text: Studio.image-path;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    overflow: elide;
                    path-touch := TouchArea { }
                }
            }
            VerticalLayout {
                alignment: center;
                Mono {
                    text: Studio.image-size;
                    font-size: 15px;
                }
            }
            Rectangle {
                width: 6px;
            }
            VerticalLayout {
                alignment: center;
                GhostButton {
                    text: "Change image";
                    clicked => { Studio.choose-image(); }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 24px;
            VerticalLayout {
                width: 228px;
                alignment: center;
                Body {
                    text: "Expected SHA-256";
                    font-size: 13px;
                    font-weight: 600;
                }
                Label {
                    text: "From the download page · optional";
                    font-size: 13px;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 6px;
                TextField {
                    height: 36px;
                    inset: 12px;
                    font-size: 12px;
                    label: "Expected SHA-256";
                    placeholder: "Paste the SHA-256 shown on the download page";
                    text <=> Studio.expected-sha;
                    error: Studio.sha-error != "";
                    edited(text) => { Studio.expected-sha-edited(text); }
                }
                if Studio.sha-error != "": Body {
                    text: Studio.sha-error;
                    font-size: 13px;
                    color: Theme.error-text;
                    wrap: word-wrap;
                }
            }
        }
    }

    if path-touch.has-hover && path-text.preferred-width > path-text.width: Tooltip {
        x: 46px;
        y: 50px;
        text: Studio.image-path;
    }
}

// Step 1 once an image is chosen (frames 02–04).
export component ImageCheckedScreen inherits VerticalLayout {
    spacing: 0;

    ImageCard { }
    Rectangle {
        height: 18px;
    }
    SectionHeader {
        title: "Image plan";
        caption: "Reported by the OSflux engine";
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 14px;
            Label {
                text: "Plan status";
                font-size: 13px;
            }
            StatusLabel {
                status: Studio.plan-status;
                text: Studio.plan-status-label;
                icon-size: 18px;
            }
        }
    }
    for row in Studio.plan-rows: KeyValueRow {
        key: row.key;
        value: row.value;
        mono: row.mono;
        value-mark: row.value-mark;
        detail: row.detail;
        detail-mark: row.detail-mark;
        secondary: row.secondary;
    }
    Rectangle {
        height: 14px;
    }
    VerticalLayout {
        spacing: 8px;
        for note in Studio.plan-notes: NoteRow {
            status: note.status;
            text: note.text;
        }
    }
}

// A heading that opens and closes the section under it.
component Disclosure inherits Rectangle {
    in-out property <bool> open;
    in property <string> title;
    in property <string> caption;
    // The strong rule underneath, as under "Not allowed".
    in property <bool> rule;

    height: 44px;
    accessible-role: button;
    accessible-label: title;
    accessible-expandable: true;
    accessible-expanded: open;
    accessible-action-default => { open = !open; }
    accessible-action-expand => { open = !open; }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open = !root.open; }
    }
    HorizontalLayout {
        padding-left: 18px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Image {
                width: 14px;
                height: 14px;
                source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                colorize: Theme.text-secondary;
            }
        }
        Body {
            text: root.title;
            font-weight: 600;
            vertical-alignment: center;
        }
        Label {
            text: root.caption;
            font-size: 13px;
            letter-spacing: Theme.body-spacing;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    if root.rule: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-strong;
    }
}

// Step 2 (frames 05–06).
export component DriveScreen inherits VerticalLayout {
    spacing: 0;

    if Studio.drives.length > 0: VerticalLayout {
        DriveTableHeader { }
        for drive[index] in Studio.drives: DriveRow {
            model: drive.model;
            path: drive.path;
            size: drive.size;
            bus: drive.bus;
            media: drive.media;
            kind: drive.kind;
            status: drive.status;
            status-label: drive.status-label;
            status-detail: drive.status-detail;
            selected: drive.selected;
            clicked => { Studio.select-drive(index); }
        }
    }

    if Studio.drives.length == 0: Rectangle {
        height: 357px;
        background: Theme.layer-01;
        accessible-role: groupbox;
        accessible-label: Studio.drives-listed ? "No removable drives found" : "Looking for drives";

        VerticalLayout {
            alignment: center;
            spacing: 0;
            HorizontalLayout {
                alignment: center;
                Image {
                    width: 28px;
                    height: 28px;
                    source: @image-url("icons/usb.svg");
                    colorize: Theme.text-secondary;
                }
            }
            Rectangle {
                height: 18px;
            }
            Body {
                text: Studio.drives-listed ? "No removable drives found" : "Looking for drives…";
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 6px;
            }
            Body {
                text: Studio.drives-listed ? "Plug in a USB stick or SD card, then click Refresh."
                    : "OSflux is asking Windows which drives are connected.";
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 18px;
            }
            HorizontalLayout {
                alignment: center;
                SquareButton {
                    width: 176px;
                    button-height: 48px;
                    text: "Refresh";
                    kind: ButtonKind.secondary;
                    enabled: !Studio.drives-busy;
                    icon: @image-url("icons/refresh.svg");
                    clicked => { Studio.refresh(); }
                }
            }
        }
    }

    if Studio.blocked-drives.length > 0: VerticalLayout {
        if Studio.drives.length == 0: Rectangle {
            height: 24px;
        }
        Disclosure {
            open <=> Studio.blocked-open;
            rule: true;
            title: "Not allowed (" + Studio.blocked-drives.length + ")";
            caption: Studio.drives.length == 0 ? "OSflux found these drives but will not erase them."
                : "OSflux will not erase these drives.";
        }
        if Studio.blocked-open: VerticalLayout {
            for drive in Studio.blocked-drives: BlockedDriveRow {
                model: drive.model;
                path: drive.path;
                size: drive.size;
                bus: drive.bus;
                reason: drive.reason;
                kind: drive.kind;
            }
        }
    }
}

// Step 3 (frames 07–08).
export component SafetyScreen inherits VerticalLayout {
    spacing: 0;

    if Studio.checks.length > 0: VerticalLayout {
        Rectangle {
            height: 1px;
            background: Theme.border-strong;
        }
        for check in Studio.checks: ChecklistRow {
            status: check.status;
            title: check.title;
            detail: check.detail;
            value: check.value;
        }
        Rectangle {
            height: 20px;
        }
        Disclosure {
            open <=> Studio.details-open;
            title: "Technical details";
            caption: "Engine values, in full";
        }
        if Studio.details-open: Rectangle {
            background: Theme.layer-01;
            VerticalLayout {
                padding: 16px;
                padding-top: 14px;
                padding-bottom: 18px;
                DetailGrid {
                    rows: Studio.details;
                }
            }
        }
    }
}

// Step 4 for Windows installers (frames 09–10): five options, all off.
export component WindowsOptionsScreen inherits VerticalLayout {
    spacing: 0;

    Band {
        kind: BandKind.info;
        body: "These settings apply to every PC that boots from this stick.";
    }
    Rectangle {
        height: 16px;
    }
    Rectangle {
        height: 1px;
        background: Theme.border-strong;
    }
    OptionRow {
        text: "Skip the TPM 2.0, Secure Boot and 4 GB RAM checks";
        description: "Lets Windows Setup run on PCs that fail these checks.";
        checked: Studio.option-bypass;
        toggled(on) => { Studio.set-option(0, on); }
        if Studio.option-bypass: VerticalLayout {
            padding-top: 6px;
            Band {
                kind: BandKind.amber;
                compact: true;
                body: "Microsoft doesn't support Windows 11 on PCs that fail these checks.";
            }
        }
    }
    OptionRow {
        text: "Use a local account instead of a Microsoft account";
        description: "Setup creates this account and skips the Microsoft sign-in.";
        checked: Studio.option-local-account;
        toggled(on) => { Studio.set-option(1, on); }
        if Studio.option-local-account: VerticalLayout {
            padding-top: 8px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 16px;
                Label {
                    width: 66px;
                    text: "Username";
                    font-size: 13px;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    TextField {
                        width: 180px;
                        height: 38px;
                        inset: 12px;
                        mono: false;
                        label: "Username";
                        placeholder: "Account name";
                        text <=> Studio.account-name;
                        error: Studio.account-error != "";
                        edited(text) => { Studio.account-name-edited(text); }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 2px;
                        Image {
                            width: 14px;
                            height: 14px;
                            source: @image-url("icons/info.svg");
                            colorize: Theme.text-secondary;
                        }
                    }
                    Body {
                        text: "Windows Setup will ask for the password. OSflux never stores it on the stick.";
                        font-size: 13px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                        vertical-alignment: top;
                        horizontal-stretch: 1;
                    }
                }
            }
            if Studio.account-error != "": Body {
                text: Studio.account-error;
                font-size: 13px;
                color: Theme.error-text;
                wrap: word-wrap;
            }
        }
    }
    OptionRow {
        text: "Skip the privacy questions";
        description: "Setup chooses the private answer to each question.";
        checked: Studio.option-privacy;
        toggled(on) => { Studio.set-option(2, on); }
    }
    OptionRow {
        text: "Turn off automatic BitLocker drive encryption";
        description: "Stops Windows from encrypting the drive by itself after setup.";
        checked: Studio.option-bitlocker;
        toggled(on) => { Studio.set-option(3, on); }
    }
    OptionRow {
        text: "Use this PC's region and keyboard settings";
        description: "Copies this PC's formats and keyboard layout into Setup.";
        checked: Studio.option-region;
        toggled(on) => { Studio.set-option(4, on); }
    }
}

// A label over a value on the Confirm card.
component CardValue inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono;

    spacing: 4px;
    Label {
        text: root.label;
        font-size: 13px;
    }
    Text {
        text: root.value;
        font-family: root.mono ? Theme.mono : Theme.sans;
        font-size: root.mono ? 14px : Theme.body-size;
        letter-spacing: root.mono ? 0 : Theme.body-spacing;
        color: Theme.text;
    }
}

// A line under the drive on the Confirm card.
component CardRow inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;

    padding-top: 6px;
    padding-bottom: 6px;
    Label {
        width: 148px;
        text: root.key;
        font-size: 13px;
        vertical-alignment: top;
    }
    Body {
        text: root.value;
        wrap: word-wrap;
        vertical-alignment: top;
        horizontal-stretch: 1;
    }
}

// The drive that will be erased and its code (frames 11–13, 21).
component ConfirmCard inherits Rectangle {
    background: Theme.layer-01;

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 24px;
            padding-top: 18px;
            padding-bottom: 10px;
            spacing: 13px;
            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    DriveIcon {
                        width: 20px;
                        height: 20px;
                        kind: Studio.confirm-drive.kind;
                    }
                }
                Body {
                    text: Studio.confirm-drive.model;
                    font-size: 20px;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    Tag {
                        text: "Will be erased";
                    }
                }
            }
            HorizontalLayout {
                spacing: 32px;
                alignment: start;
                CardValue {
                    label: "Device";
                    value: Studio.confirm-drive.path;
                    mono: true;
                }
                CardValue {
                    label: "Size";
                    value: Studio.confirm-drive.size;
                    mono: true;
                }
                CardValue {
                    label: "Bus";
                    value: Studio.confirm-drive.bus;
                }
                CardValue {
                    label: "Media";
                    value: Studio.confirm-drive.media;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Label {
                    text: "Engine status";
                    font-size: 13px;
                }
                StatusLabel {
                    status: Studio.confirm-drive.status;
                    text: Studio.confirm-drive.status-label;
                }
            }
            VerticalLayout {
                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }
                Rectangle {
                    height: 6px;
                }
                if Studio.confirm-options != "": CardRow {
                    key: "Windows options";
                    value: Studio.confirm-options;
                }
                CardRow {
                    key: "Verify after writing";
                    value: Studio.confirm-verify;
                }
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.border-subtle;
        }
        VerticalLayout {
            width: 216px;
            alignment: center;
            padding-left: 24px;
            spacing: 6px;
            Label {
                text: "Drive code";
                font-size: 13px;
            }
            Mono {
                text: Studio.drive-code;
                font-size: 32px;
                font-weight: 500;
                letter-spacing: 2.5px;
                color: Theme.link;
            }
        }
    }
}

component InfoNote inherits HorizontalLayout {
    in property <string> text;
    spacing: 8px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Image {
            width: 14px;
            height: 14px;
            source: @image-url("icons/info.svg");
            colorize: Theme.text-secondary;
        }
    }
    Body {
        text: root.text;
        font-size: 13px;
        color: Theme.text-secondary;
    }
}

// The Confirm step: the drive code for an empty drive (frames 11–13), the
// full phrase otherwise (frame 14), and the expired state (frame 21).
export component ConfirmScreen inherits VerticalLayout {
    spacing: 0;

    if Studio.confirm-error != "": Band {
        kind: BandKind.red;
        title: "No confirmation";
        body: Studio.confirm-error;
    }

    if Studio.confirm-error == "" && !Studio.confirm-busy && Studio.confirm-short: VerticalLayout {
        spacing: 0;
        ConfirmCard { }
        if !Studio.confirm-expired: VerticalLayout {
            spacing: 0;
            Rectangle {
                height: 26px;
            }
            Body {
                text: "Type the drive code to confirm";
                font-size: 16px;
                font-weight: 600;
            }
            Rectangle {
                height: 14px;
            }
            HorizontalLayout {
                alignment: start;
                boxes := CodeBoxes {
                    text <=> Studio.typed;
                    characters: Studio.typed-characters;
                    state: Studio.match-state;
                    edited(text) => { Studio.typed-edited(text); }
                    init => { self.focus-input(); }
                }
            }
            Rectangle {
                height: 12px;
            }
            InfoNote {
                text: "This code identifies this exact drive. If the drive changes, the code changes.";
            }
            Rectangle {
                height: 12px;
            }
            MatchMessage {
                state: Studio.match-state;
                text: Studio.match-message;
            }
        }
    }

    if Studio.confirm-error == "" && !Studio.confirm-busy && !Studio.confirm-short: VerticalLayout {
        spacing: 0;
        Band {
            kind: BandKind.amber;
            compact: true;
            body: Studio.contents-note;
        }
        Rectangle {
            height: 16px;
        }
        Band {
            kind: BandKind.red;
            title: Studio.erase-title;
            body: Studio.erase-body;
        }
        if !Studio.confirm-expired: VerticalLayout {
            spacing: 0;
            Rectangle {
                height: 22px;
            }
            Label {
                text: "Type this phrase to confirm";
                font-size: 13px;
            }
            Rectangle {
                height: 10px;
            }
            Rectangle {
                height: 70px;
                background: Theme.layer-01;
                accessible-role: AccessibleRole.text;
                accessible-label: "Type this phrase: " + Studio.phrase-head + Studio.phrase-code;
                HorizontalLayout {
                    padding-left: 24px;
                    alignment: start;
                    Mono {
                        text: Studio.phrase-head;
                        font-size: 28px;
                        font-weight: 500;
                        letter-spacing: 2.2px;
                    }
                    code := Mono {
                        text: Studio.phrase-code;
                        font-size: 28px;
                        font-weight: 500;
                        letter-spacing: 2.2px;
                        color: Theme.link;
                        Rectangle {
                            y: parent.height - 12px;
                            height: 2px;
                            background: Theme.link;
                        }
                    }
                }
            }
            Rectangle {
                height: 10px;
            }
            InfoNote {
                text: "The last 4 characters identify this exact drive. If the drive changes, the phrase changes.";
            }
            Rectangle {
                height: 26px;
            }
            PhraseField {
                label: "Confirmation phrase";
                text <=> Studio.typed;
                expected-length: (Studio.phrase-head + Studio.phrase-code).character-count;
                state: Studio.match-state;
                message: Studio.match-message;
                edited(text) => { Studio.typed-edited(text); }
                init => { self.focus-input(); }
            }
        }
    }

    if Studio.confirm-error == "" && !Studio.confirm-busy && Studio.confirm-expired: VerticalLayout {
        Rectangle {
            height: 24px;
        }
        Band {
            kind: BandKind.amber;
            title: "Confirmation expired";
            body: "Confirmations last 10 minutes. Check this is still the right drive, then confirm it again.";
            VerticalLayout {
                alignment: center;
                SquareButton {
                    width: 232px;
                    button-height: 48px;
                    text: "Confirm the drive again";
                    kind: ButtonKind.primary;
                    icon: @image-url("icons/refresh.svg");
                    clicked => { Studio.confirm-again(); }
                }
            }
        }
    }
}
