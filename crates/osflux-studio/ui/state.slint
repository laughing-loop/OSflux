// The state the shell and screens read, filled in by the Rust side, and the
// actions they send back. Studio decides nothing about safety here:
// statuses, codes and phrases come from the engine.

import { ThemeChoice, Status } from "theme.slint";
import { PhaseState } from "components/progress.slint";

export { PhaseState }

export enum Screen { image, drive, safety, windows-options, confirm, writing, done }

export enum StepState { pending, current, done, blocked }

export struct StepData {
    title: string,
    subtitle: string,
    // File names are shown in Plex Mono.
    subtitle-mono: bool,
    // The untruncated subtitle, shown on hover when `subtitle` is shortened.
    subtitle-full: string,
    state: StepState,
    // Done steps can be clicked to go back to them.
    clickable: bool,
}

// "This session" at the bottom of the rail.
export struct SummaryData {
    image: string,
    image-full: string,
    image-chosen: bool,
    drive: string,
    // Windows options are listed only for Windows images.
    show-windows-options: bool,
    windows-options: string,
}

export enum DriveKind { usb, sd-card, disk }

export enum MatchState { empty, typing, mismatch, match }

// The icon before the action bar's hint.
export enum HintIcon { none, shield, lock, warning, info, log }

// One write phase on the Writing screen (frames 15–17).
export struct PhaseData {
    title: string,
    engine-phase: string,
    description: string,
    state: PhaseState,
    percent: string,
    progress: float,
    speed: string,
    done: string,
    time: string,
}

// One line of the Done screen's result list (frames 18–20).
export struct ResultRowData {
    key: string,
    key-detail: string,
    value: string,
    mono: bool,
    // The value in red: the hash that does not match.
    alert: bool,
    status: Status,
    status-text: string,
    detail: string,
}

// One line of the image plan (frames 02–04).
export struct PlanRowData {
    key: string,
    value: string,
    mono: bool,
    value-mark: Status,
    detail: string,
    detail-mark: Status,
    secondary: bool,
}

// A note under the image plan; `none` shows the information icon.
export struct NoteData {
    status: Status,
    text: string,
}

// A drive the engine allows (frame 05).
export struct DriveData {
    model: string,
    path: string,
    size: string,
    bus: string,
    media: string,
    kind: DriveKind,
    status: Status,
    status-label: string,
    status-detail: string,
    selected: bool,
}

// A drive OSflux will not erase, with the engine's reason in plain words.
export struct BlockedDriveData {
    model: string,
    path: string,
    size: string,
    bus: string,
    reason: string,
    kind: DriveKind,
}

// One line of the safety check (frames 07–08).
export struct CheckData {
    status: Status,
    title: string,
    detail: string,
    value: string,
}

// The chosen drive on the Confirm card (frames 11–13).
export struct ConfirmDriveData {
    model: string,
    path: string,
    size: string,
    bus: string,
    media: string,
    kind: DriveKind,
    status: Status,
    status-label: string,
}

// An engine key and its value, for technical details.
export struct DetailData {
    key: string,
    value: string,
}

// One line of technical details: two keys side by side, so a value that
// wraps keeps both columns in step.
export struct DetailRowData {
    left-key: string,
    left-value: string,
    right-key: string,
    right-value: string,
    // A long value, such as every boot file, across the whole panel.
    wide: bool,
}

export global Studio {
    // Header and status bar
    in property <string> version: "0.1.0";
    in property <string> engine-version: "0.1.0";
    in property <bool> administrator: true;
    in property <bool> writing;
    in property <string> drives-scanned;

    // Rail
    in property <[StepData]> steps;
    in property <SummaryData> summary;

    // The current screen's title block and action bar
    in property <Screen> screen: Screen.image;
    in property <string> step-label;
    in property <string> title;
    in property <string> description;
    in property <string> hint;
    in property <HintIcon> hint-icon: HintIcon.none;
    in property <bool> can-go-back;
    in property <bool> can-go-next;
    // "Choose another image" in the action bar, when the image can't be written.
    in property <bool> offer-another-image;

    // Step 1 once an image is chosen
    in property <bool> image-chosen;
    // The engine is reading the image.
    in property <bool> image-busy;
    in property <string> image-error;
    in property <string> image-name;
    in property <string> image-path;
    in property <string> image-size;
    in property <Status> plan-status: Status.none;
    in property <string> plan-status-label;
    in property <[PlanRowData]> plan-rows;
    in property <[NoteData]> plan-notes;
    in-out property <string> expected-sha;
    in property <string> sha-error;

    // Step 2
    in property <bool> drives-busy;
    // At least one scan has finished.
    in property <bool> drives-listed;
    in property <[DriveData]> drives;
    in property <[BlockedDriveData]> blocked-drives;
    in-out property <bool> blocked-open;
    in property <string> image-needs;

    // Step 3
    in property <bool> safety-busy;
    in property <Status> verdict: Status.none;
    in property <string> checks-passed;
    // "Choose another drive" or "Choose another image" next to a blocked verdict.
    in property <string> fix-label;
    in property <[CheckData]> checks;
    in property <[DetailRowData]> details;
    in-out property <bool> details-open: true;

    // Step 4, Windows options (frames 09–10)
    in property <bool> option-bypass;
    in property <bool> option-local-account;
    in property <bool> option-privacy;
    in property <bool> option-bitlocker;
    in property <bool> option-region;
    in-out property <string> account-name;
    in property <string> account-error;

    // Confirm (frames 11–14, 21)
    in property <bool> confirm-busy;
    // Why no confirmation could be offered, such as a changed drive.
    in property <string> confirm-error;
    // The drive code confirms (an empty drive), not the full phrase.
    in property <bool> confirm-short;
    // A drive with files: its code and a ticked box naming what will be lost
    // confirm, not the full phrase.
    in property <bool> confirm-acknowledge;
    // The box's text, from the engine: what will be lost.
    in property <string> acknowledgement;
    in-out property <bool> acknowledged;
    in property <ConfirmDriveData> confirm-drive;
    in property <string> confirm-options;
    in property <string> confirm-verify;
    in property <string> drive-code;
    in property <string> phrase-head;
    in property <string> phrase-code;
    in property <string> contents-note;
    in property <string> erase-title;
    in property <string> erase-body;
    in-out property <string> typed;
    in property <[string]> typed-characters: ["", "", "", ""];
    in property <MatchState> match-state: MatchState.empty;
    in property <string> match-message;
    in property <bool> confirm-expired;
    in property <bool> can-write;

    // Writing and verifying (frames 15–17)
    in property <string> write-head;
    in property <string> write-head-detail;
    in property <[PhaseData]> write-phases;
    in property <bool> write-verify-off;
    in property <bool> cancelling;

    // Done (frames 18–20), and a write that did not finish
    in property <Status> done-status: Status.none;
    in property <string> done-band-title;
    in property <string> done-band-body;
    // Red band (hash mismatch, failed); amber otherwise.
    in property <bool> done-band-red;
    in property <[ResultRowData]> done-rows;
    in property <string> done-next;
    in property <string> done-primary-label;

    // Settings
    in-out property <bool> settings-open;
    in-out property <bool> about-open;
    in-out property <bool> showing-licences;
    in property <ThemeChoice> theme-choice: ThemeChoice.system;
    in property <bool> verify-after-writing: true;

    // About
    in property <string> platform;
    in property <string> gpl-text;
    in property <string> font-licence-text;

    callback next();
    callback back();
    callback go-to-step(int);
    callback choose-image();
    callback expected-sha-edited(string);
    callback select-drive(int);
    callback fix();
    // Windows option 0–4 ticked or cleared.
    callback set-option(int, bool);
    callback account-name-edited(string);
    callback typed-edited(string);
    // "Restart as Administrator" on Confirm (frame 23).
    callback restart-as-administrator();
    // Cancel on the Writing screen.
    callback cancel-write();
    // The Done screen's main button: "Write another stick" or "Try again".
    callback done-primary();
    callback acknowledged-changed(bool);
    callback confirm-again();
    callback write();
    callback refresh();
    callback set-theme(ThemeChoice);
    callback set-verify-after-writing(bool);
    callback open-audit-log();
    // "website", "source" or "issues".
    callback open-link(string);
}
